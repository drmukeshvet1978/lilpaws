# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/lilpaws

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS - comma separated list of allowed frontend origins
CLIENT_URLS=http://localhost:5173,http://localhost:3000

# Rate limiting (appointment submission)
APPOINTMENT_RATE_LIMIT_WINDOW_MINUTES=15
APPOINTMENT_RATE_LIMIT_MAX=8

# Default admin (used only by seed script)
SEED_ADMIN_EMAIL=admin@lilpaws.in
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_ADMIN_NAME=Dr. Mukesh Tiwari
